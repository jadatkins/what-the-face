{
  "name": "what-the-face",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "dotenvx run -- react-router dev",
    "start": "dotenvx run -- react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "test:e2e": "dotenvx run -- playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/react-router": "^3.6.18",
    "@dotenvx/dotenvx": "^2.21.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@clerk/backend": "3.16.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "git-format-staged": "^4.0.2",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
